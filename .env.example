# Early Access metafields API - environment variables
#
# Local use: copy to .env.local, fill in the values, then run `npm run definitions`.
#   cp .env.example .env.local
# Vercel: add each one with `vercel env add <NAME> production`, then redeploy.
# Never commit .env.local or any file holding real values.

# The store the API serves, as store-name.myshopify.com.
# Admin API calls go here; app proxy requests from any other shop are refused.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public storefront origin the quiz popup runs on, such as https://www.example.com.
# A bare host (www.example.com) means https. No path. Comma-separate several (for example with and without www).
# Requests whose browser Origin is any other site are refused.
# https://<SHOPIFY_STORE_DOMAIN> is always allowed and does not need listing.
SHOPIFY_STOREFRONT_ORIGIN=https://www.your-store.com

# Client ID of the Dev Dashboard app: 32 letters and digits, no shp prefix.
# Used with the secret to request Admin API tokens. Not an shpat_ or shpca_ access token.
SHOPIFY_API_KEY=

# Client secret of the same app (starts with shpss_). SECRET - keep it out of the theme, logs and chat.
# Verifies the app proxy signature on every storefront request and requests Admin API tokens.
SHOPIFY_API_SECRET=

# Metaobject type that holds the quiz answers. One entry per customer.
EARLY_ACCESS_METAOBJECT_TYPE=early_access_submission

# Customer metafield, as namespace.key, that points to the customer's metaobject entry.
EARLY_ACCESS_CUSTOMER_METAFIELD=early_access.submission

# -----------------------------------------------------------------------------
# Reference only - nothing below is read from this file.
# -----------------------------------------------------------------------------
#
# App access scopes (set on the app version in the Dev Dashboard)
#
#   write_customers               set the EARLY_ACCESS_CUSTOMER_METAFIELD metafield on the customer
#   write_files                   upload the run screenshot to Shopify Files
#   write_metaobjects             create and update the Early Access submission entries
#   write_metaobject_definitions  only for `npm run definitions`; can be removed after setup
#
#   Each write scope includes its read scope. No other scope is needed.
#   If the logs say "not approved to access the Customer object", also request
#   protected customer data access, level 1 (no name, email, phone or address fields).
#
# App proxy (same app version)
#
#   Prefix: apps    Subpath: early-access
#   Proxy URL: https://<deployment>/api/early-access
#
# Metaobject definition (created by `npm run definitions`)
#
#   Name: Early Access submission        Type: EARLY_ACCESS_METAOBJECT_TYPE
#   Display name field: pass_number      Storefront access: off
#   Entries: one per customer, handle customer-<customer id>
#
#   Key              Name              Type                          Required  Example value
#   pass_number      Pass number       single_line_text_field        yes       2QF03HNHX
#   weekly_distance  Weekly distance   single_line_text_field        yes       10-25-km
#   run_screenshot   Run screenshot    file_reference (images only)  no        gid://shopify/MediaImage/123
#   surfaces         Running surfaces  list.single_line_text_field   yes       ["road","trail"]
#   goal             Running goal      single_line_text_field        yes       half-marathon
#   shoe_fit         Shoe fit          single_line_text_field        yes       mens
#   shoe_size        Shoe size (UK)    single_line_text_field        yes       9
#   submitted_at     Submitted at      date_time                     yes       2026-11-19T12:00:00Z
#
# Customer metafield definition (created by `npm run definitions`)
#
#   Name: Early Access submission
#   Namespace and key: EARLY_ACCESS_CUSTOMER_METAFIELD
#   Type: metaobject_reference, limited to EARLY_ACCESS_METAOBJECT_TYPE entries
#   Pinned, so it shows on the customer page in admin